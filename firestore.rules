rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function isValidRSVP(data) {
      return data.keys().hasAll(['id', 'name', 'attendance', 'guests', 'message', 'createdAt'])
        && data.keys().size() == 6
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && (data.attendance == 'yes' || data.attendance == 'no' || data.attendance == 'maybe')
        && data.guests is int && data.guests >= 0 && data.guests <= 50
        && data.message is string && data.message.size() <= 1000
        && data.createdAt is string && data.createdAt.size() <= 100;
    }

    match /rsvps/{rsvpId} {
      // Allow unrestricted read/list so anyone opening the invitation can read the blessings
      allow read, list: if true;

      // Allow creating an RSVP
      allow create: if isValidId(rsvpId) && isValidRSVP(request.resource.data);
      
      // Permit deletion for administrative convenience
      allow delete: if true;
    }
  }
}
